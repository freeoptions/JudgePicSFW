                                        <DataTrigger Binding="{Binding IsAllFilterActive}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryTintBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="10,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Foreground="{StaticResource PrimaryBrush}" FontSize="13" Text="全部" TextWrapping="NoWrap" />
                                <TextBlock Margin="6,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding TotalCount}" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,8,0" Padding="0" Command="{Binding ShowSfwCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MetricChipButtonStyle}">
                                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
                                    <Setter Property="Height" Value="38" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSfwFilterActive}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SuccessTintBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="10,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Foreground="{StaticResource SuccessBrush}" FontSize="13" Text="{Binding PrimaryFilterLabel}" TextWrapping="NoWrap" />
                                <TextBlock Margin="6,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Text="{Binding SfwCount}" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,8,0" Padding="0" Command="{Binding ShowNsfwCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MetricChipButtonStyle}">
                                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
                                    <Setter Property="Height" Value="38" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNsfwFilterActive}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource DangerTintBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="10,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Foreground="{StaticResource DangerBrush}" FontSize="13" Text="{Binding SecondaryFilterLabel}" TextWrapping="NoWrap" />
                                <TextBlock Margin="6,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" Text="{Binding NsfwCount}" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,8,0" Padding="0" Command="{Binding ShowUncertainCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MetricChipButtonStyle}">
                                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
                                    <Setter Property="Height" Value="38" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUncertainFilterActive}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource WarningTintBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="10,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Foreground="{StaticResource WarningBrush}" FontSize="13" Text="不确定" TextWrapping="NoWrap" />
                                <TextBlock Margin="6,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Text="{Binding UncertainCount}" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Button>
                        <Button Padding="0" Command="{Binding ShowCorrectedCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MetricChipButtonStyle}">
                                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
                                    <Setter Property="Height" Value="38" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCorrectedFilterActive}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="10,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Foreground="{StaticResource InkMutedBrush}" FontSize="13" Text="已人工处理" TextWrapping="NoWrap" />
                                <TextBlock Margin="6,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}" Text="{Binding CorrectedCount}" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <Border Grid.Row="4"
                            Padding="10,0,10,8"
                            BorderBrush="{StaticResource OutlineBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.6*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="1.1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Foreground="{StaticResource InkMutedBrush}" FontSize="12" Text="文件名" />
                            <TextBlock Grid.Column="1" Foreground="{StaticResource InkMutedBrush}" FontSize="12" Text="分辨率" />
                            <TextBlock Grid.Column="2" Foreground="{StaticResource InkMutedBrush}" FontSize="12" Text="置信度" />
                            <TextBlock Grid.Column="3" Foreground="{StaticResource InkMutedBrush}" FontSize="12" Text="结果" />
                            <TextBlock Grid.Column="4" Foreground="{StaticResource InkMutedBrush}" FontSize="12" Text="来源" />
                        </Grid>
                    </Border>

                    <ListBox x:Name="ResultsListBox"
                             Grid.Row="6"
                             ItemsSource="{Binding Results}"
                             SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.IsDeferredScrollingEnabled="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:AnalysisItemViewModel}">
                                <Grid MinHeight="34">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.6*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="1.1*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="15"
                                                 Height="15"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Rectangle Canvas.Left="4"
                                                           Canvas.Top="5"
                                                           Width="16"
                                                           Height="14"
                                                           RadiusX="2"
                                                           RadiusY="2"
                                                           Fill="Transparent"
                                                           Stroke="{StaticResource PrimaryBrush}"
                                                           StrokeThickness="2" />
                                                <Path Data="M7,16 L11,12 L14,15 L16,13 L20,17"
                                                      Fill="Transparent"
                                                      Stroke="{StaticResource PrimaryBrush}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                                <Ellipse Canvas.Left="8"
                                                         Canvas.Top="8"
                                                         Width="2.8"
                                                         Height="2.8"
                                                         Fill="{StaticResource PrimaryBrush}" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Text="{Binding FileName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   ToolTip="{Binding FilePath}" />
                                    </Grid>
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               FontSize="12"
                                               Text="{Binding ResolutionText}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource InkBrush}"
                                               FontSize="12"
                                               Text="{Binding ConfidenceText}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />

                                    <Border Grid.Column="3"
                                            Padding="10,4"
                                            CornerRadius="8"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentLabel}" Value="{x:Static models:ImageLabel.Sfw}">
                                                        <Setter Property="Background" Value="{StaticResource SuccessTintBrush}" />
                                                    </DataTrigger>
                                                     <DataTrigger Binding="{Binding CurrentLabel}" Value="{x:Static models:ImageLabel.Nsfw}">
                                                         <Setter Property="Background" Value="{StaticResource DangerTintBrush}" />
                                                     </DataTrigger>
                                                     <DataTrigger Binding="{Binding CurrentLabel}" Value="{x:Static models:ImageLabel.Person}">
                                                         <Setter Property="Background" Value="{StaticResource SuccessTintBrush}" />
                                                     </DataTrigger>
                                                     <DataTrigger Binding="{Binding CurrentLabel}" Value="{x:Static models:ImageLabel.NonPerson}">
                                                         <Setter Property="Background" Value="{StaticResource PrimaryTintBrush}" />
                                                     </DataTrigger>
                                                      <DataTrigger Binding="{Binding CurrentLabel}" Value="{x:Static models:ImageLabel.Uncertain}">
                                                          <Setter Property="Background" Value="{StaticResource WarningTintBrush}" />
                                                      </DataTrigger>
                                                 </Style.Triggers>
                                             </Style>
                                         </Border.Style>
                                        <TextBlock FontSize="12" Text="{Binding CurrentLabelText}" TextWrapping="NoWrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentLabel}" Value="{x:Static models:ImageLabel.Sfw}">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                         <DataTrigger Binding="{Binding CurrentLabel}" Value="{x:Static models:ImageLabel.Nsfw}">
                                                             <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                         </DataTrigger>
                                                         <DataTrigger Binding="{Binding CurrentLabel}" Value="{x:Static models:ImageLabel.Person}">
                                                             <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                         </DataTrigger>
                                                         <DataTrigger Binding="{Binding CurrentLabel}" Value="{x:Static models:ImageLabel.NonPerson}">
                                                             <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                         </DataTrigger>
                                                          <DataTrigger Binding="{Binding CurrentLabel}" Value="{x:Static models:ImageLabel.Uncertain}">
                                                              <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                          </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <TextBlock Grid.Column="4"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               FontSize="12"
                                               Text="{Binding LabelOriginText}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="6"
                            IsHitTestVisible="False"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="20"
                            Background="Transparent"
                            BorderThickness="0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TotalCount}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Viewbox Width="42" Height="42" HorizontalAlignment="Center">
                                <Canvas Width="48" Height="48">
                                    <Rectangle Canvas.Left="7"
                                               Canvas.Top="9"
                                               Width="34"
                                               Height="30"
                                               RadiusX="5"
                                               RadiusY="5"
                                               Fill="{StaticResource SurfaceSoftBrush}"
                                               Stroke="{StaticResource OutlineStrongBrush}"
                                               StrokeThickness="1.5" />
                                    <Path Data="M11,34 L20,25 L26,31 L31,27 L38,34"
                                          Fill="Transparent"
                                          Stroke="{StaticResource OutlineStrongBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                    <Ellipse Canvas.Left="15"
                                             Canvas.Top="15"
                                             Width="6"
                                             Height="6"
                                             Fill="{StaticResource PrimaryTintBrush}"
                                             Stroke="{StaticResource OutlineStrongBrush}"
                                             StrokeThickness="1.2" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock HorizontalAlignment="Center"
                                       Margin="0,10,0,0"
                                       Foreground="{StaticResource InkMutedBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Text="等待扫描结果" />
                            <TextBlock Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource InkMutedBrush}"
                                       FontSize="12"
                                       Text="开始扫描后，图片会按表格列表逐步显示在这里。"
                                       TextWrapping="NoWrap"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="326" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardBorderStyle}" Padding="18,16" Background="{StaticResource HeroBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Margin="0,0,20,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="扫描进度" />
                                <Button Grid.Column="1"
                                        Padding="8,4"
                                        Style="{StaticResource MiniOutlineButtonStyle}"
                                        Command="{Binding StopScanCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Rectangle Canvas.Left="7" Canvas.Top="5" Width="3.5" Height="14" RadiusX="1" RadiusY="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <Rectangle Canvas.Left="13.5" Canvas.Top="5" Width="3.5" Height="14" RadiusX="1" RadiusY="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="暂停扫描" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="98" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Width="84" Height="84" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Ellipse Stroke="{StaticResource SurfaceMutedBrush}" StrokeThickness="8" />
                                    <Ellipse Stroke="{StaticResource PrimaryBrush}"
                                             StrokeThickness="8"
                                             StrokeDashArray="{Binding ProgressValue, Converter={x:Static local:BooleanBoxes.ProgressToRingDashArray}}"
                                             StrokeStartLineCap="Round"
                                             StrokeEndLineCap="Round">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90" CenterX="42" CenterY="42" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource HeadingFontFamily}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Text="{Binding ProgressPercentText}"
                                               TextWrapping="NoWrap" />
                                </Grid>

                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.ColumnSpan="2"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Text="{Binding StatusTitle}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Row="1"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               FontSize="12"
                                               Text="已处理"
                                               TextWrapping="NoWrap" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="{Binding ProgressCountText}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />

                                    <TextBlock Grid.Row="2"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               FontSize="12"
                                               Text="当前对象"
                                               TextWrapping="NoWrap" />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="1"
                                               FontSize="12"
                                               Text="{Binding StatusCurrentItem}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               ToolTip="{Binding StatusCurrentItem}" />

                                    <TextBlock Grid.Row="3"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               FontSize="12"
                                               Text="状态说明"
                                               TextWrapping="NoWrap" />
                                    <TextBlock Grid.Row="3"
                                               Grid.Column="1"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               FontSize="12"
                                               Text="{Binding StatusMessage}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               ToolTip="{Binding StatusMessage}" />
                                </Grid>
                            </Grid>

                             <Grid Grid.Row="3" Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource StatusPillBorderStyle}"
                                            Background="{StaticResource PrimaryTintBrush}"
                                            BorderBrush="{StaticResource OutlineStrongBrush}"
                                            HorizontalAlignment="Left">
                                        <TextBlock Foreground="{StaticResource PrimaryBrush}"
                                                   FontSize="12"
                                                   Text="{Binding StatusStageText}"
                                                   TextWrapping="NoWrap" />
                                    </Border>
                                    <Border Grid.Column="1"
                                            Margin="14,0,0,0"
                                            Padding="12,5"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource DividerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <TextBlock Foreground="{StaticResource InkMutedBrush}"
                                                   FontSize="12"
                                                   Text="{Binding ProgressCountText}"
                                                   TextWrapping="NoWrap" />
                                    </Border>
                                </Grid>
                                <ProgressBar Grid.Row="2" Minimum="0" Maximum="1" Value="{Binding ProgressValue, Mode=OneWay}" />
                            </Grid>
                        </Grid>

                        <Border Grid.Column="1"
                                Margin="0,4,0,4"
                                Background="{StaticResource DividerBrush}" />

                        <Grid Grid.Column="3" Margin="4,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="操作日志" />
                                <Border Grid.Column="1"
                                        Style="{StaticResource StatusPillBorderStyle}"
                                        VerticalAlignment="Top">
                                    <TextBlock FontSize="12"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               Text="{Binding OperationLogs.Count, StringFormat={}{0} 条}" />
                                </Border>
                            </Grid>

                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Hidden"
                                          PanningMode="VerticalFirst">
                                <ItemsControl ItemsSource="{Binding OperationLogs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:OperationLogItemViewModel}">
                                            <Border Margin="0,0,0,5" CornerRadius="5" Padding="6,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="58" />
                                                        <ColumnDefinition Width="3" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               VerticalAlignment="Top"
                                                               Foreground="{StaticResource InkMutedBrush}"
                                                               FontSize="11"
                                                               Text="{Binding TimestampText}"
                                                               TextWrapping="NoWrap" />
                                                    <Border Grid.Column="1" CornerRadius="2">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource OutlineStrongBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static viewModels:OperationLogLevel.Success}">
                                                                        <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static viewModels:OperationLogLevel.Error}">
                                                                        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <StackPanel Grid.Column="3">
                                                        <TextBlock FontWeight="SemiBold"
                                                                   FontSize="12"
                                                                   LineHeight="17"
                                                                   MaxHeight="36"
                                                                   Text="{Binding Message, Mode=OneWay}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Level}" Value="{x:Static viewModels:OperationLogLevel.Success}">
                                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Level}" Value="{x:Static viewModels:OperationLogLevel.Error}">
                                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Margin="0,3,0,0"
                                                                   Foreground="{StaticResource InkMutedBrush}"
                                                                   FontSize="11"
                                                                   LineHeight="16"
                                                                   MaxHeight="34"
                                                                   Text="{Binding Detail, Mode=OneWay}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="Wrap"
                                                                   ToolTip="{Binding Detail}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="4"
                                                            Margin="8,0,0,0"
                                                            Padding="5"
                                                            VerticalAlignment="Top"
                                                            Command="{Binding DataContext.CopyOperationLogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="复制日志">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource MiniOutlineButtonStyle}">
                                                                <Setter Property="Opacity" Value="0.2" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
