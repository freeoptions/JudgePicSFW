                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="&#39044;&#35272;&#19982;&#32416;&#27491;" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource SectionMetaTextStyle}"
                                   Text="&#36825;&#37324;&#29992;&#20110;&#22797;&#26597;&#27599;&#24352;&#22270;&#29255;&#30340;&#26368;&#32456;&#24402;&#31867;&#12290;&#20320;&#30340;&#25913;&#21028;&#20250;&#30452;&#25509;&#20889;&#22238;&#32531;&#23384;&#65292;&#24182;&#24433;&#21709;&#21518;&#32493;&#30456;&#20284;&#22270;&#29255;&#30340;&#21028;&#26029;&#12290;" />
                    </StackPanel>

                    <Border Grid.Row="2"
                            Style="{StaticResource SoftCardBorderStyle}"
                            Padding="16"
                            PreviewMouseWheel="OnReviewAreaPreviewMouseWheel">
                        <Grid>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource InkMutedBrush}"
                                       Visibility="{Binding SelectedResult, Converter={x:Static local:BooleanBoxes.NullToVisible}}"
                                       Text="&#35831;&#20808;&#22312;&#24038;&#20391;&#36873;&#25321;&#19968;&#24352;&#22270;&#29255;&#36827;&#34892;&#39044;&#35272;&#12290;" />
                            <Image Source="{Binding DisplayedPreviewImage}" Stretch="Uniform" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="4"
                                PreviewMouseWheel="OnReviewAreaPreviewMouseWheel">
                        <Border Style="{StaticResource SoftCardBorderStyle}" Padding="16">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding SelectedResult.FileName, TargetNullValue=&#23578;&#26410;&#36873;&#25321;&#22270;&#29255;}" />
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource SectionMetaTextStyle}"
                                           Text="{Binding SelectedResult.FilePath, TargetNullValue=&#36873;&#25321;&#21015;&#34920;&#39033;&#21518;&#65292;&#36825;&#37324;&#20250;&#26174;&#31034;&#22270;&#29255;&#30340;&#23436;&#25972;&#36335;&#24452;&#12290;}" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Border Padding="10,4"
                                            Background="{StaticResource PrimaryTintBrush}"
                                            CornerRadius="10">
                                        <TextBlock Foreground="{StaticResource PrimaryBrush}"
                                                   FontSize="12"
                                                   Text="{Binding SelectedResult.CurrentLabelText, TargetNullValue=&#24403;&#21069;&#26631;&#31614;}" />
                                    </Border>
                                    <Border Margin="8,0,0,0"
                                            Padding="10,4"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource OutlineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <TextBlock FontSize="12"
                                                   Text="{Binding SelectedResult.ConfidenceText, TargetNullValue=&#32622;&#20449;&#24230; --}" />
                                    </Border>
                                    <Border Margin="8,0,0,0"
                                            Padding="10,4"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource OutlineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <TextBlock FontSize="12"
                                                   Text="{Binding SelectedResult.LabelOriginText, TargetNullValue=&#26631;&#31614;&#26469;&#28304;}" />
                                    </Border>
                                </WrapPanel>
                                <TextBlock Margin="0,12,0,0"
                                           Style="{StaticResource SectionMetaTextStyle}"
                                           Text="{Binding SelectedResult.Explanation, TargetNullValue=&#20998;&#26512;&#21407;&#22240;&#20250;&#26174;&#31034;&#22312;&#36825;&#37324;&#12290;}" />
                            </StackPanel>
                        </Border>

                        <UniformGrid Margin="0,16,0,0" Columns="2">
                            <Button Margin="0,0,10,0"
                                    IsEnabled="{Binding CanMarkAsPrimary}"
                                    Command="{Binding MarkAsSfwCommand}"
                                    Content="{Binding MarkAsPrimaryButtonText}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Margin="0,0,10,0"
                                    IsEnabled="{Binding CanMarkAsSecondary}"
                                    Command="{Binding MarkAsNsfwCommand}"
                                    Content="{Binding MarkAsSecondaryButtonText}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                    </Style>
                                </Button.Style>
                            </Button>

                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Panel.ZIndex="50"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,12,28,0"
                Padding="14,10"
                MaxWidth="520"
                BorderThickness="1"
                CornerRadius="9"
                Visibility="{Binding IsToastVisible, Converter={x:Static local:BooleanBoxes.BoolToVisible}}"
                IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource PrimaryTintBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastLevel}" Value="{x:Static viewModels:OperationLogLevel.Success}">
                            <Setter Property="Background" Value="{StaticResource SuccessTintBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ToastLevel}" Value="{x:Static viewModels:OperationLogLevel.Error}">
                            <Setter Property="Background" Value="{StaticResource DangerTintBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock FontWeight="SemiBold"
                       FontSize="13"
                       Text="{Binding ToastMessage}"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ToastLevel}" Value="{x:Static viewModels:OperationLogLevel.Success}">
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ToastLevel}" Value="{x:Static viewModels:OperationLogLevel.Error}">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</Window>



