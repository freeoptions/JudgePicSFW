<Window x:Class="JudgePicSFW.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JudgePicSFW"
        xmlns:models="clr-namespace:JudgePicSFW.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:viewModels="clr-namespace:JudgePicSFW.ViewModels"
        mc:Ignorable="d"
        Title="图片安全判断"
        Icon="Assets/JudgePicSFW.ico"
        Width="1675"
        Height="940"
        MinWidth="1360"
        MinHeight="760"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="50"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate x:Key="CompactWorkspaceFolderTemplate"
                      DataType="{x:Type viewModels:WorkspaceFolderItemViewModel}">
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CompactFolderRowBorderStyle}">
                        <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
                        <Setter Property="Opacity" Value="0.78" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Background" Value="{StaticResource SelectionBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Viewbox Width="19" Height="16" VerticalAlignment="Center">
                        <Canvas Width="24" Height="20">
                            <Path Data="M2,5 H9 L11,7 H22 V18 H2 Z"
                                  Fill="#F7B928"
                                  Stroke="#E9A814"
                                  StrokeThickness="0.8"
                                  StrokeLineJoin="Round" />
                            <Path Data="M2,5 V3 H9 L11,5"
                                  Fill="#FFD56A"
                                  Stroke="#E9A814"
                                  StrokeThickness="0.8"
                                  StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="{Binding FolderName}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                        <TextBlock Margin="0,2,0,0"
                                   Foreground="{StaticResource InkMutedBrush}"
                                   FontSize="10.5"
                                   Text="{Binding FolderPath}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   ToolTip="{Binding FolderPath}" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            MinWidth="52"
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Style="{StaticResource MiniOutlineButtonStyle}"
                            Command="{Binding DataContext.ActivateWorkspaceFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Content="{Binding ActiveStateText}" />
                    <Button Grid.Column="4"
                            VerticalAlignment="Center"
                            Style="{StaticResource IconOnlyButtonStyle}"
                            Command="{Binding DataContext.RemoveWorkspaceFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="移除文件夹">
                        <Viewbox Width="13" Height="13">
                            <Canvas Width="24" Height="24">
                                <Path Data="M7,7 L17,17 M17,7 L7,17"
                                      Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource OutlineBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="26"
                           Height="26"
                           Source="Assets/JudgePicSFW.png"
                           Stretch="Uniform" />
                    <TextBlock Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource HeadingFontFamily}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="图片安全判断"
                               TextWrapping="NoWrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Width="46"
                             Height="50"
                            Padding="0"
                            Background="{StaticResource SurfaceBrush}"
                             BorderThickness="0"
                             Foreground="{StaticResource InkBrush}"
                             Click="OnMinimizeButtonClick">
                        <Viewbox Width="13" Height="13">
                            <Canvas Width="24" Height="24">
                                <Path Data="M5,12 H19"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Width="46"
                             Height="50"
                            Padding="0"
                            Background="{StaticResource SurfaceBrush}"
                             BorderThickness="0"
                             Foreground="{StaticResource InkBrush}"
                             Click="OnMaximizeRestoreButtonClick">
                        <Viewbox Width="13" Height="13">
                            <Canvas Width="24" Height="24">
                                <Rectangle Canvas.Left="5.5"
                                           Canvas.Top="5.5"
                                           Width="13"
                                           Height="13"
                                           RadiusX="1"
                                           RadiusY="1"
                                           Fill="Transparent"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="1.6" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Width="52"
                             Height="50"
                            Padding="0"
                            Background="{StaticResource SurfaceBrush}"
                             BorderThickness="0"
                             Foreground="{StaticResource InkBrush}"
                             Click="OnCloseButtonClick">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Path Data="M6.5,6.5 L17.5,17.5 M17.5,6.5 L6.5,17.5"
                                      Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12,10,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="590" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="520" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="12,6,0,0" Visibility="Collapsed">
                    <TextBlock FontFamily="{StaticResource HeadingFontFamily}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}"
                               Text="图片安全判断"
                               TextWrapping="NoWrap" />
                     <TextBlock Margin="2,4,0,0"
                                Foreground="{StaticResource InkMutedBrush}"
                                FontSize="13"
                                Text="{Binding AppSubtitle}"
                                TextWrapping="NoWrap" />
                </StackPanel>

                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Hidden"
                              PanningMode="VerticalFirst">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="任务配置" />
                            <Border Margin="0,8,0,14"
                                    Height="1"
                                    Background="{StaticResource OutlineBrush}" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="任务类型" />
                                <Button Grid.Column="1"
                                        Margin="6,0,0,0"
                                        Style="{StaticResource InfoIconButtonStyle}"
                                        ToolTip="{Binding TaskModeDescription}">
                                    <Image Width="18"
                                           Height="18"
                                           Source="Assets/info-local.png"
                                           Stretch="Uniform" />
                                </Button>
                            </Grid>
                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <Button Margin="0,0,6,0"
                                        Command="{Binding ShowContentSafetyTaskCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsContentSafetyTaskActive}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryTintBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="24"
                                                Height="24"
                                                CornerRadius="5"
                                                Background="{StaticResource PrimaryBrush}">
                                            <Viewbox Width="15"
                                                     Height="15"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M12,3 L19,6 V11 C19,15.5 16.2,19.1 12,21 C7.8,19.1 5,15.5 5,11 V6 Z"
                                                          Fill="Transparent"
                                                          Stroke="White"
                                                          StrokeThickness="2"
                                                          StrokeLineJoin="Round" />
                                                    <Path Data="M8.5,12 L11,14.5 L15.8,9.2"
                                                          Fill="Transparent"
                                                          Stroke="White"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Text="内容安全分类"
                                                   TextWrapping="NoWrap" />
                                    </Grid>
                                </Button>
                                <Button Margin="6,0,0,0"
                                        Command="{Binding ShowPersonTaskCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPersonTaskActive}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryTintBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="24"
                                                Height="24"
                                                CornerRadius="5"
                                                Background="{StaticResource SurfaceSoftBrush}"
                                                BorderBrush="{StaticResource OutlineBrush}"
                                                BorderThickness="1">
                                            <Viewbox Width="15"
                                                     Height="15"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Ellipse Canvas.Left="8"
                                                             Canvas.Top="4"
                                                             Width="8"
                                                             Height="8"
                                                             Fill="Transparent"
                                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                             StrokeThickness="2" />
                                                    <Path Data="M5,21 C5.7,16.8 8.2,14.5 12,14.5 C15.8,14.5 18.3,16.8 19,21"
                                                          Fill="Transparent"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Text="人物非人物分类"
                                                   TextWrapping="NoWrap" />
                                    </Grid>
                                </Button>
                            </UniformGrid>
                            <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="模型选择" />
                            <Border Margin="0,0,0,10"
                                    Padding="11,8"
                                    Background="{StaticResource SurfaceSoftBrush}"
                                    BorderBrush="{StaticResource OutlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource InkBrush}"
                                               FontSize="12"
                                               Text="{Binding AiModelStatusText}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               ToolTip="{Binding AiModelStatusText}" />
                                    <Viewbox Grid.Column="1"
                                             Width="12"
                                             Height="12"
                                             Margin="8,0,0,0"
                                             VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M6,9 L12,15 L18,9"
                                                  Fill="Transparent"
                                                  Stroke="{StaticResource InkMutedBrush}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Border>

                             <Grid Margin="0,0,0,14" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="58" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" FontSize="12" Text="置信度策略" />
                                    <ProgressBar Margin="0,8,0,0" Minimum="0" Maximum="1" Value="0.6" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Margin="10,14,0,0"
                                        Padding="8,5"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource OutlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <TextBlock HorizontalAlignment="Center"
                                               Foreground="{StaticResource InkBrush}"
                                               FontSize="12"
                                               Text="0.60"
                                               TextWrapping="NoWrap" />
                                </Border>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource SectionTitleTextStyle}"
                                           FontSize="15"
                                           Text="样本库" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource InfoIconButtonStyle}"
                                        ToolTip="{Binding SampleLibrarySummary}">
                                    <Image Width="18"
                                           Height="18"
                                           Source="Assets/info-local.png"
                                           Stretch="Uniform" />
                                </Button>
                                <Button Grid.Column="3"
                                        Style="{StaticResource MiniOutlineButtonStyle}"
                                        Command="{Binding RefreshSamplesCommand}"
                                        Content="扫描样本" />
                            </Grid>
                            <WrapPanel Margin="0,0,0,14" Visibility="Collapsed">
                                <Border Style="{StaticResource StatusPillBorderStyle}" Background="{StaticResource SuccessTintBrush}">
                                     <TextBlock Foreground="{StaticResource SuccessBrush}"
                                                FontSize="12"
                                                Text="{Binding PrimarySampleCountText}" />
                                 </Border>
                                 <Border Margin="8,0,0,0"
                                         Style="{StaticResource StatusPillBorderStyle}"
                                         Background="{StaticResource DangerTintBrush}">
                                     <TextBlock Foreground="{StaticResource DangerBrush}"
                                                FontSize="12"
                                                Text="{Binding SecondarySampleCountText}" />
                                 </Border>
                             </WrapPanel>

                            <Expander Header="样本文件夹详情" IsExpanded="False" Margin="0,0,0,10">
                                <StackPanel Margin="0,10,0,0">
                                    <UniformGrid Columns="2" Margin="0,0,0,10">
                                         <Button Margin="0,0,6,0"
                                                 Style="{StaticResource MiniTintButtonStyle}"
                                                 Command="{Binding AddSfwSampleFolderCommand}"
                                                 Content="{Binding AddPrimarySampleButtonText}" />
                                         <Button Margin="6,0,0,0"
                                                 Style="{StaticResource MiniTintButtonStyle}"
                                                 Command="{Binding AddNsfwSampleFolderCommand}"
                                                 Content="{Binding AddSecondarySampleButtonText}" />
                                    </UniformGrid>

                                    <ItemsControl ItemsSource="{Binding SfwSampleFolders}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type viewModels:SampleFolderItemViewModel}">
                                                <Border Margin="0,0,0,8">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource WorkspaceRowBorderStyle}">
                                                            <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
                                                            <Setter Property="Opacity" Value="1" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                    <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
                                                                    <Setter Property="Opacity" Value="0.48" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding FolderName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                            <TextBlock Margin="0,4,0,0"
                                                                       Foreground="{StaticResource InkMutedBrush}"
                                                                       FontSize="12"
                                                                       Text="{Binding FolderPath}"
                                                                       TextWrapping="Wrap"
                                                                       ToolTip="{Binding FolderPath}" />
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="1"
                                                                  Margin="8,0"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding IsEnabled}"
                                                                  Content="{Binding LearningStateText}" />
                                                        <Button Grid.Column="2"
                                                                Style="{StaticResource MiniOutlineButtonStyle}"
                                                                Command="{Binding DataContext.RemoveSampleFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Content="移除" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding NsfwSampleFolders}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type viewModels:SampleFolderItemViewModel}">
                                                <Border Margin="0,0,0,8">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource WorkspaceRowBorderStyle}">
                                                            <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
                                                            <Setter Property="Opacity" Value="1" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                    <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
                                                                    <Setter Property="Opacity" Value="0.48" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding FolderName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                            <TextBlock Margin="0,4,0,0"
                                                                       Foreground="{StaticResource InkMutedBrush}"
                                                                       FontSize="12"
                                                                       Text="{Binding FolderPath}"
                                                                       TextWrapping="Wrap"
                                                                       ToolTip="{Binding FolderPath}" />
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="1"
                                                                  Margin="8,0"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding IsEnabled}"
                                                                  Content="{Binding LearningStateText}" />
                                                        <Button Grid.Column="2"
                                                                Style="{StaticResource MiniOutlineButtonStyle}"
                                                                Command="{Binding DataContext.RemoveSampleFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Content="移除" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>

                             <Expander Header="{Binding PersonalAiPanelTitle}"
                                       IsExpanded="False"
                                       Margin="0,0,0,12">
                             <Border Margin="0,8,0,0"
                                     Padding="10"
                                     Background="{StaticResource SurfaceSoftBrush}"
                                     BorderBrush="{StaticResource OutlineBrush}"
                                     BorderThickness="1"
                                     CornerRadius="6">
                                 <StackPanel>
                                     <Grid Margin="0,0,0,8">
                                         <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="*" />
                                             <ColumnDefinition Width="Auto" />
                                         </Grid.ColumnDefinitions>
                                         <StackPanel>
                                             <TextBlock FontSize="14"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding PersonalAiModelTitle}" />
                                             <TextBlock Margin="0,4,0,0"
                                                        Style="{StaticResource SectionMetaTextStyle}"
                                                        Text="{Binding PersonalAiStatusText}"
                                                        TextWrapping="Wrap" />
                                         </StackPanel>
                                         <Border Grid.Column="1"
                                                 Margin="10,0,0,0"
                                                 Padding="8,3"
                                                 BorderThickness="1"
                                                 CornerRadius="6"
                                                 VerticalAlignment="Top">
                                             <Border.Style>
                                                 <Style TargetType="Border">
                                                     <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                                     <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding HasActivePersonalAiModel}" Value="True">
                                                             <Setter Property="Background" Value="{StaticResource SuccessTintBrush}" />
                                                             <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </Border.Style>
                                             <TextBlock FontWeight="SemiBold"
                                                        FontSize="11"
                                                        Text="{Binding PersonalAiModePillText}">
                                                 <TextBlock.Style>
                                                     <Style TargetType="TextBlock">
                                                         <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding HasActivePersonalAiModel}" Value="True">
                                                                 <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </TextBlock.Style>
                                             </TextBlock>
                                         </Border>
                                     </Grid>
                                     <ItemsControl Margin="0,0,0,10"
                                                   ItemsSource="{Binding PersonalAiModelVersions}">
                                         <ItemsControl.ItemTemplate>
                                             <DataTemplate DataType="{x:Type models:PersonalAiModelVersionInfo}">
                                                 <Border Margin="0,0,0,8"
