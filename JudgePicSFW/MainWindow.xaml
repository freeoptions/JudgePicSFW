<Window x:Class="JudgePicSFW.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JudgePicSFW"
        xmlns:models="clr-namespace:JudgePicSFW.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:viewModels="clr-namespace:JudgePicSFW.ViewModels"
        mc:Ignorable="d"
        Title="图片安全判断"
        Icon="Assets/JudgePicSFW.ico"
        Width="1675"
        Height="940"
        MinWidth="1360"
        MinHeight="760"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="{StaticResource BodyFontFamily}"
        FontSize="12"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="50"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate x:Key="CompactWorkspaceFolderTemplate"
                      DataType="{x:Type viewModels:WorkspaceFolderItemViewModel}">
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CompactFolderRowBorderStyle}">
                        <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
                        <Setter Property="Opacity" Value="0.78" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Background" Value="{StaticResource SelectionBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Viewbox Width="19" Height="16" VerticalAlignment="Center">
                        <Canvas Width="24" Height="20">
                            <Path Data="M2,5 H9 L11,7 H22 V18 H2 Z"
                                  Fill="#F7B928"
                                  Stroke="#E9A814"
                                  StrokeThickness="0.8"
                                  StrokeLineJoin="Round" />
                            <Path Data="M2,5 V3 H9 L11,5"
                                  Fill="#FFD56A"
                                  Stroke="#E9A814"
                                  StrokeThickness="0.8"
                                  StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="{Binding FolderName}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                        <TextBlock Margin="0,2,0,0"
                                   Foreground="{StaticResource InkMutedBrush}"
                                    FontSize="11"
                                   Text="{Binding FolderPath}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   ToolTip="{Binding FolderPath}" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            MinWidth="52"
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Style="{StaticResource MiniOutlineButtonStyle}"
                            Command="{Binding DataContext.ActivateWorkspaceFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Content="{Binding ActiveStateText}" />
                    <Button Grid.Column="4"
                            VerticalAlignment="Center"
                            Style="{StaticResource IconOnlyButtonStyle}"
                            Command="{Binding DataContext.RemoveWorkspaceFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="移除文件夹">
                        <Viewbox Width="13" Height="13">
                            <Canvas Width="24" Height="24">
                                <Path Data="M7,7 L17,17 M17,7 L7,17"
                                      Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
        <!-- Shared widths keep the header and virtualized rows aligned at both breakpoints. -->
        <GridLength x:Key="ResultResolutionColumnWidth">104</GridLength>
        <GridLength x:Key="ResultConfidenceColumnWidth">64</GridLength>
        <GridLength x:Key="ResultLabelColumnWidth">72</GridLength>
        <GridLength x:Key="ResultOriginColumnWidth">88</GridLength>

        <Style x:Key="WorkbenchCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Padding" Value="16,14" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Padding" Value="14,12" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FilterContentStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Orientation" Value="Vertical" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FilterCountStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Margin" Value="0,2,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ResultRowStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowChrome" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowChrome" Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowChrome" Property="Background" Value="{StaticResource SelectionBrush}" />
                                <Setter TargetName="RowChrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="RowChrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResultLabelBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentLabel}" Value="{x:Static models:ImageLabel.Unknown}">
                    <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentLabel}" Value="{x:Static models:ImageLabel.Uncertain}">
                    <Setter Property="Background" Value="{StaticResource WarningTintBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentLabel}" Value="{x:Static models:ImageLabel.Sfw}">
                    <Setter Property="Background" Value="{StaticResource SuccessTintBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentLabel}" Value="{x:Static models:ImageLabel.Person}">
                    <Setter Property="Background" Value="{StaticResource SuccessTintBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentLabel}" Value="{x:Static models:ImageLabel.Nsfw}">
                    <Setter Property="Background" Value="{StaticResource DangerTintBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentLabel}" Value="{x:Static models:ImageLabel.NonPerson}">
                    <Setter Property="Background" Value="{StaticResource DangerTintBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ResultLabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentLabel}" Value="{x:Static models:ImageLabel.Unknown}">
                    <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentLabel}" Value="{x:Static models:ImageLabel.Uncertain}">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentLabel}" Value="{x:Static models:ImageLabel.Sfw}">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentLabel}" Value="{x:Static models:ImageLabel.Person}">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentLabel}" Value="{x:Static models:ImageLabel.Nsfw}">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentLabel}" Value="{x:Static models:ImageLabel.NonPerson}">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ResultLabelTemplate" DataType="{x:Type viewModels:AnalysisItemViewModel}">
            <Border Style="{StaticResource ResultLabelBorderStyle}">
                <TextBlock Style="{StaticResource ResultLabelTextStyle}" Text="{Binding CurrentLabelText, TargetNullValue=--, FallbackValue=--}" />
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource OutlineBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="26"
                           Height="26"
                           Source="Assets/JudgePicSFW.png"
                           Stretch="Uniform" />
                    <TextBlock Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource HeadingFontFamily}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="图片安全判断"
                               TextWrapping="NoWrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Width="46"
                             Height="50"
                            Padding="0"
                            Background="{StaticResource SurfaceBrush}"
                             BorderThickness="0"
                             Foreground="{StaticResource InkBrush}"
                             Click="OnMinimizeButtonClick">
                        <Viewbox Width="13" Height="13">
                            <Canvas Width="24" Height="24">
                                <Path Data="M5,12 H19"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Width="46"
                             Height="50"
                            Padding="0"
                            Background="{StaticResource SurfaceBrush}"
                             BorderThickness="0"
                             Foreground="{StaticResource InkBrush}"
                             Click="OnMaximizeRestoreButtonClick">
                        <Viewbox Width="13" Height="13">
                            <Canvas Width="24" Height="24">
                                <Rectangle Canvas.Left="5.5"
                                           Canvas.Top="5.5"
                                           Width="13"
                                           Height="13"
                                           RadiusX="1"
                                           RadiusY="1"
                                           Fill="Transparent"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="1.6" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Width="52"
                             Height="50"
                            Padding="0"
                            Background="{StaticResource SurfaceBrush}"
                             BorderThickness="0"
                             Foreground="{StaticResource InkBrush}"
                             Click="OnCloseButtonClick">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Path Data="M6.5,6.5 L17.5,17.5 M17.5,6.5 L6.5,17.5"
                                      Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="WorkbenchRoot" Grid.Row="1" Margin="12,10,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22*" MinWidth="280" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="36*" MinWidth="450" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="42*" MinWidth="520" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource WorkbenchCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="任务配置" />
                            <Border Margin="0,8,0,10"
                                    Height="1"
                                    Background="{StaticResource OutlineBrush}" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="任务类型" />
                                <Button Grid.Column="1"
                                        Margin="6,0,0,0"
                                        Style="{StaticResource InfoIconButtonStyle}"
                                        ToolTip="{Binding TaskModeDescription}">
                                    <Image Width="18"
                                           Height="18"
                                           Source="Assets/info-local.png"
                                           Stretch="Uniform" />
                                </Button>
                            </Grid>
                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <Button Margin="0,0,6,0"
                                        Command="{Binding ShowContentSafetyTaskCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsContentSafetyTaskActive}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryTintBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="24"
                                                Height="24"
                                                CornerRadius="5"
                                                Background="{StaticResource PrimaryBrush}">
                                            <Viewbox Width="15"
                                                     Height="15"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M12,3 L19,6 V11 C19,15.5 16.2,19.1 12,21 C7.8,19.1 5,15.5 5,11 V6 Z"
                                                          Fill="Transparent"
                                                          Stroke="White"
                                                          StrokeThickness="2"
                                                          StrokeLineJoin="Round" />
                                                    <Path Data="M8.5,12 L11,14.5 L15.8,9.2"
                                                          Fill="Transparent"
                                                          Stroke="White"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Text="内容安全分类"
                                                   TextWrapping="NoWrap" />
                                    </Grid>
                                </Button>
                                <Button Margin="6,0,0,0"
                                        Command="{Binding ShowPersonTaskCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPersonTaskActive}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryTintBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="24"
                                                Height="24"
                                                CornerRadius="5"
                                                Background="{StaticResource SurfaceSoftBrush}"
                                                BorderBrush="{StaticResource OutlineBrush}"
                                                BorderThickness="1">
                                            <Viewbox Width="15"
                                                     Height="15"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Ellipse Canvas.Left="8"
                                                             Canvas.Top="4"
                                                             Width="8"
                                                             Height="8"
                                                             Fill="Transparent"
                                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                             StrokeThickness="2" />
                                                    <Path Data="M5,21 C5.7,16.8 8.2,14.5 12,14.5 C15.8,14.5 18.3,16.8 19,21"
                                                          Fill="Transparent"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Text="人物 / 非人物"
                                                   TextWrapping="NoWrap" />
                                    </Grid>
                                </Button>
                            </UniformGrid>
                            <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="模型摘要" />
                            <ToggleButton x:Name="AiModelDetailsToggle"
                                          Margin="0,0,0,6"
                                          Padding="11,8"
                                          Background="{StaticResource SurfaceSoftBrush}"
                                          BorderBrush="{StaticResource OutlineBrush}"
                                          BorderThickness="1"
                                          Foreground="{StaticResource InkBrush}"
                                          HorizontalContentAlignment="Stretch">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleChrome"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleChrome" Property="Background" Value="{StaticResource PrimaryTintBrush}" />
                                                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleChrome" Property="Background" Value="{StaticResource PrimaryTintBrush}" />
                                                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ToggleChrome" Property="Opacity" Value="0.82" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource InkBrush}"
                                               FontSize="12"
                                               Text="{Binding AiModelStatusText}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               ToolTip="{Binding AiModelStatusText}" />
                                    <Viewbox Grid.Column="1"
                                             Width="12"
                                             Height="12"
                                             Margin="8,0,0,0"
                                             VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M6,9 L12,15 L18,9"
                                                  Fill="Transparent"
                                                  Stroke="{StaticResource InkMutedBrush}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" Value="True">
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <RotateTransform Angle="180" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </ToggleButton>
                            <Border Margin="0,0,0,10"
                                    Padding="10"
                                    Background="{StaticResource SurfaceSoftBrush}"
                                    BorderBrush="{StaticResource OutlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="{Binding IsChecked, ElementName=AiModelDetailsToggle, Converter={x:Static local:BooleanBoxes.BoolToVisible}}">
                                <StackPanel>
                                    <TextBlock FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="当前使用的 AI 模型组合" />
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               FontSize="12"
                                               Text="{Binding AiModelStatusText}"
                                               TextWrapping="Wrap" />
                                    <Button Margin="0,8,0,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource MiniOutlineButtonStyle}"
                                            Command="{Binding InstallAiModelCommand}"
                                            Content="{Binding AiModelButtonText}" />
                                </StackPanel>
                            </Border>

                             <Grid Margin="0,0,0,14" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="58" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" FontSize="12" Text="置信度策略" />
                                    <ProgressBar Margin="0,8,0,0" Minimum="0" Maximum="1" Value="0.6" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Margin="10,14,0,0"
                                        Padding="8,5"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource OutlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <TextBlock HorizontalAlignment="Center"
                                               Foreground="{StaticResource InkBrush}"
                                               FontSize="12"
                                               Text="0.60"
                                               TextWrapping="NoWrap" />
                                </Border>
                            </Grid>
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalFirst">
                        <StackPanel Margin="0,0,5,0">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
